{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/marcusbandit/anibeam-endpoints/schema/endpoint.schema.json",
  "title": "AniBeam endpoint definition",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "version", "lang", "kind", "url", "auth", "min_core"],
  "if": { "properties": { "kind": { "const": "torznab" } } },
  "then": {
    "properties": {
      "url": {
        "$comment": "A torznab url may name the person's own Prowlarr or Jackett as {host}, the whole authority, and only then be plain http.",
        "pattern": "^(https://|http://\\{host\\}([/?#]|$))"
      }
    }
  },
  "else": { "properties": { "url": { "pattern": "^https://" } } },
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "integer", "minimum": 1 },
    "lang": { "type": "string", "pattern": "^([a-z]{2}|all)$" },
    "kind": { "enum": ["filtered-rss", "json-feed", "rss", "torznab"] },
    "url": { "type": "string" },
    "auth": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "label", "secret"],
        "properties": {
          "key": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "label": { "type": "string", "minLength": 1 },
          "secret": { "type": "boolean" },
          "help": { "type": "string" },
          "help_url": { "type": "string", "pattern": "^https://" }
        }
      }
    },
    "front": { "type": ["string", "null"] },
    "rate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["per_minute"],
      "properties": { "per_minute": { "type": "integer", "minimum": 1 } }
    },
    "nsfw": { "type": "boolean" },
    "category": { "type": "string" },
    "filter": { "type": "string" },
    "min_core": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "trusted_groups": {
      "$comment": "Release groups best fit prefers out of the box: AniBeam trusts the groups its enabled endpoints list.",
      "type": "array",
      "maxItems": 32,
      "items": { "type": "string", "minLength": 1, "maxLength": 64 }
    },
    "quality_local": {
      "$comment": "rss only: the search matches post text, so AniBeam takes quality words out of it and narrows the results itself.",
      "type": "boolean"
    },
    "one_variant": {
      "$comment": "rss only: a subscription whose query picks no variant excludes this word, so each episode comes down once.",
      "type": "string",
      "pattern": "^[A-Za-z0-9-]{1,32}$"
    },
    "show_feed": {
      "$comment": "rss only: each page pattern reads a show's slug from a result's post page, in a group named slug; url is the show's own feed, on the endpoint's host.",
      "type": "object",
      "additionalProperties": false,
      "required": ["pages", "url"],
      "properties": {
        "pages": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "type": "string", "maxLength": 400 } },
        "url": { "type": "string", "pattern": "^https://[^{}]*\\{slug\\}[^{}]*$" }
      }
    }
  }
}
