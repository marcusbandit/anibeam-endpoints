{
  "id": "erai",
  "name": "Erai-raws",
  "version": 2,
  "lang": "en",
  "kind": "rss",
  "url": "https://www.erai-raws.info/episodes/feed/?res=1080p&type=torrent&subs%5B0%5D=us&s={query}&token={token}",
  "auth": [
    {
      "key": "token",
      "label": "RSS token",
      "secret": true,
      "help": "Log in on erai-raws.info, open the RSS page and copy the token= value from any feed link.",
      "help_url": "https://www.erai-raws.info/rss-page/"
    }
  ],
  "front": null,
  "rate": { "per_minute": 20 },
  "nsfw": false,
  "min_core": "2.4.0",
  "trusted_groups": ["Erai-raws"],
  "quality_local": true,
  "one_variant": "HEVC",
  "show_feed": {
    "pages": [
      "^https://www\\.erai-raws\\.info/(?:episodes|specials|raws)/(?P<slug>[a-z0-9-]+?)-\\d+(?:v\\d+)?/",
      "^https://www\\.erai-raws\\.info/encodes/(?P<slug>[a-z0-9-]+?)-\\d+(?:v\\d+)?-hevc/",
      "^https://www\\.erai-raws\\.info/batches/(?P<slug>[a-z0-9-]+?)-\\d+-\\d+/"
    ],
    "url": "https://www.erai-raws.info/anime-list/{slug}/feed/"
  }
}
